{
  "name": "ip-radar-cf",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A Chinese-first IP intelligence and network privacy diagnostics platform on Cloudflare Workers.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "cf:dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "cf:types": "wrangler types"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "wrangler": "^4.50.0"
  }
}
